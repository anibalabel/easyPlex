{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easyplex",
  "main": "dist-worker/index.js",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/admin/*",
      "/installer-api/*",
      "/auth/*",
      "/storage/*",
      "/health",
      "/login",
      "/register",
      "/logout",
      "/password/*",
      "/email/*"
    ]
  }
}
