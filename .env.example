# Required Remote MySQL Credentials (set these in Cloudflare Pages -> Settings -> Environment Variables)
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSL=false

# Optional overrides (automatically loaded from `settings` table in MySQL when omitted)
# APP_NAME=
# APP_URL=
# JWT_SECRET=
# TMDB_API_KEY=
