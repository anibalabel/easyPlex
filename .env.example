# Required MySQL Credentials (set in .env / cPanel Node.js App for Namecheap, or Cloudflare Dashboard for Workers)
# On Namecheap shared hosting where MySQL is on the same server, DB_HOST is usually 127.0.0.1 or localhost
DB_HOST=mysql.us.cloudlogin.co
DB_PORT=3306
DB_DATABASE=plusmovie_st
DB_USERNAME=plusmovie_st
DB_PASSWORD=
DB_SSL=false

# Optional overrides (automatically loaded from `settings` table in MySQL when omitted)
# PORT=3000
# APP_NAME=
# APP_URL=https://panel.movflix.live
# JWT_SECRET=
# TMDB_API_KEY=
