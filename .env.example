PORT=8000
NODE_ENV=development
APP_NAME=EASYPLEX
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=easyplex-local-dev-jwt-secret
SESSION_SECRET=easyplex-local-dev-session-secret

# Database driver: "mysql" or "sqlite"
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plusmovie_st
DB_USERNAME=plusmovie_st
DB_PASSWORD=
DB_SSL=false

# Fallback SQLite path when DB_CONNECTION=sqlite
SQLITE_PATH=./data/easyplex.sqlite

TMDB_API_KEY=
DEMO_MODE=false
